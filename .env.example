# --- Base de datos (obligatoria en producción) ---------------------------
# Redis de Upstash por REST. Si la creas desde Vercel (Storage → Upstash → Redis)
# estas dos variables se agregan solas. Sin ellas la app usa memoria y los saldos
# se pierden al reiniciar.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# También se aceptan UPSTASH_REDIS_REST_URL y UPSTASH_REDIS_REST_TOKEN.

# --- Seguridad -----------------------------------------------------------
# Sal para guardar los NIP de los gafetes. Pon un valor largo y secreto.
PIN_SALT=

# --- Cobro CoDi real con Pey (opcional) ----------------------------------
# Sin PEY_API_KEY el fondeo es simulado. Con ella, el fondeo es un cobro CoDi real
# que llega a la cuenta ligada a la llave (la concentradora).
# NUNCA subas la llave al repositorio: va solo en las variables de entorno.
PEY_API_KEY=
# Opcional: secreto del webhook ({tu-dominio}/api/pey/webhook). Sin él, el pago
# se confirma consultando a Pey mientras la pantalla de fondeo espera.
PEY_WEBHOOK_SECRET=
PEY_BANK_ACCOUNT_ID=
