# --- Base de datos (obligatoria en producción) ---------------------------
# Redis de Upstash por REST. Si la creas desde Vercel (Storage → Upstash → Redis)
# estas dos variables se agregan solas. Sin ellas la app usa memoria y los saldos
# se pierden al reiniciar.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# También se aceptan UPSTASH_REDIS_REST_URL y UPSTASH_REDIS_REST_TOKEN.

# --- Seguridad -----------------------------------------------------------
# Sal para guardar los NIP de los gafetes. Pon un valor largo y secreto.
PIN_SALT=

# --- Cobro CoDi real con Pey (opcional) ----------------------------------
# Sin PEY_API_KEY el fondeo es simulado. Con ella, el fondeo genera un QR CoDi
# y se abona cuando llega el webhook a {tu-dominio}/api/pey/webhook.
PEY_API_KEY=
PEY_WEBHOOK_SECRET=
PEY_BANK_ACCOUNT_ID=
